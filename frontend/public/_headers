# HTML 不缓存（钉钉 WebView 缓存严重）
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 根路径 index.html 也不缓存
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JS/CSS 带 hash 可以长缓存
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# 其他资源不缓存
/*
  Cache-Control: no-cache, no-store, must-revalidate
