{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "frontend/dist",
      "functions": {
        "api/index.js": {
          "maxDuration": 30
        }
      },
      "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/index" },
        { "source": "/((?!api/).*)", "destination": "/$1" }
      ]
    }
  }
}
