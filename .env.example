# ============================================================
# 钉钉任务管理系统 - 环境变量示例
# 复制为各端 .env 后填写真实值
# ============================================================

# ---------- 钉钉企业内部应用 ----------
# 在 https://open.dingtalk.com → 应用开发 → 你的应用 → 基础信息
DINGTALK_APP_KEY=dingxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxx
DINGTALK_CORP_ID=dingxxxxxxxx

# ---------- Supabase ----------
# 在 https://supabase.com 项目设置 → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
# 项目设置 → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=xxxxxxxxxxxxxx

# ---------- 后端端口 ----------
PORT=8787

# ---------- 前端(复制到 frontend/.env) ----------
# Vite 要求变量以 VITE_ 开头
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
# VITE_API_BASE=/api
